# ---- Project data & artifacts (never commit PHI or large binaries) ----
data/*
*.zip
*.csv
*.csv.gz
models/*.pkl
!data/.gitkeep

# MIMIC-IV demo dataset (downloaded locally, not part of the repo)
mimic-demo/

# Model side-artifacts
models/*.png
models/*.json
# Per-run copies kept so one experiment's figures survive the next run, which
# would otherwise overwrite models/*.png in place. Derived from restricted data,
# so ignored wholesale like the rest of models/.
models/runs/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/
.env
env.bak/
venv.bak/

# ---- Testing / tooling caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.optuna/

# ---- Editors / OS ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# CatBoost training artifacts
catboost_info/
**/catboost_info/

